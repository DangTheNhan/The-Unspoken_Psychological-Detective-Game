# Sao chép thành .env.local rồi chỉnh theo máy của bạn (không commit .env.local)

# URL gốc của backend Spring Boot (mặc định khớp application.yml: port 8080)
VITE_API_URL=http://localhost:8080/api

# true = bật log chi tiết + Debug Overlay trong game (phím ` để ẩn/hiện)
# Mặc định: bật khi chạy `npm run dev`, tắt khi build production
VITE_DEBUG=
